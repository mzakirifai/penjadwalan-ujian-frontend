<?xml version="1.0" encoding="UTF-8"?>

<?import co.id.component.*?>
<?import java.lang.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            fx:controller="co.id.controller.pages.ExamScoreController"
            styleClass="list-menu-background">

    <top>
        <VBox spacing="10" styleClass="list-menu-top-vbox">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Nilai Ujian" styleClass="list-menu-top-label"/>
                <HBox HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Pilih Jadwal Ujian:" styleClass="form-field-label"/>
                <LookupBox fx:id="lookupBoxExamSchedule" promptText="Klik untuk pilih jadwal ujian"/>
                <Label fx:id="lblInfo" text="" styleClass="form-field-label"/>
                <TextField fx:id="searchField" promptText="Cari nama/NIS..."/>
                <Button fx:id="filterBtn" text="Cari">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image><Image url="@/icons/loupe.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="list-menu-center-vbox">
            <TableView fx:id="tableView" prefHeight="420">
                <columns>
                    <TableColumn fx:id="tableColumnAction" text="Aksi" prefWidth="160"/>
                    <TableColumn fx:id="tableColumnNis" text="NIS" prefWidth="100"/>
                    <TableColumn fx:id="tableColumnName" text="Nama Siswa" prefWidth="220"/>
                    <TableColumn fx:id="tableColumnScore" text="Nilai" prefWidth="100"/>
                    <TableColumn fx:id="tableColumnStatus" text="Status" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>