<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            fx:controller="co.id.controller.pages.RoomAllocationController"
            styleClass="list-menu-background">

    <top>
        <VBox spacing="10" styleClass="list-menu-top-vbox">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Penempatan Ruangan Ujian" styleClass="list-menu-top-label"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnExport" text="Export Daftar Hadir (Excel)">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image><Image url="@/icons/report.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="btnApply" text="Terapkan ke Sesi Lain"/>
                <Button fx:id="btnSave" text="Simpan Penempatan" styleClass="list-menu-top-button">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image><Image url="@/icons/save.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Tanggal:" styleClass="form-field-label"/>
                <DatePicker fx:id="datePicker"/>
                <Label text="Sesi:" styleClass="form-field-label"/>
                <ComboBox fx:id="comboSession" prefWidth="220" promptText="Pilih sesi ujian"/>
            </HBox>
            <Label fx:id="lblSessionInfo" styleClass="form-field-label" wrapText="true" maxWidth="Infinity"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="12" styleClass="list-menu-center-vbox">
            <VBox spacing="8" prefWidth="300" minWidth="260">
                <Label text="Ruangan yang dipakai" styleClass="form-field-label"/>
                <Label fx:id="lblRoomHint" wrapText="true"/>
                <ListView fx:id="listRooms" VBox.vgrow="ALWAYS"/>
                <HBox spacing="8">
                    <Button fx:id="btnSelectAll" text="Pilih / Kosongkan Semua"/>
                </HBox>
                <Button fx:id="btnAutoRooms" text="Pilih Ruangan Otomatis" maxWidth="Infinity"/>
                <Button fx:id="btnGenerate" text="Buat Penempatan Otomatis" maxWidth="Infinity" styleClass="list-menu-top-button"/>
                <Button fx:id="btnManual" text="Atur Penempatan Manual" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Isi tiap ruangan" styleClass="form-field-label"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAutoSupervisor" text="Isi Pengawas Otomatis"/>
                </HBox>
                <Label fx:id="lblStatus" wrapText="true" maxWidth="Infinity"/>
                <TableView fx:id="tableRooms" prefHeight="240">
                    <columns>
                        <TableColumn fx:id="colRoom" text="Ruangan" prefWidth="90" minWidth="70"/>
                        <TableColumn fx:id="colCapacity" text="Kapasitas" prefWidth="75" minWidth="75"/>
                        <TableColumn fx:id="colFilled" text="Terisi" prefWidth="60" minWidth="55"/>
                        <TableColumn fx:id="colClasses" text="Kelas (jumlah siswa)" prefWidth="320" minWidth="260"/>
                        <TableColumn fx:id="colSupervisor" text="Pengawas" prefWidth="240" minWidth="230"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblSeatsTitle" text="Daftar kursi: klik satu ruangan di atas" styleClass="form-field-label"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnMoveSeat" text="Pindahkan Siswa Terpilih"/>
                </HBox>
                <TableView fx:id="tableSeats" prefHeight="230" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSeat" text="Kursi" prefWidth="65"/>
                        <TableColumn fx:id="colNumber" text="No. Peserta" prefWidth="95"/>
                        <TableColumn fx:id="colNis" text="NIS" prefWidth="110"/>
                        <TableColumn fx:id="colName" text="Nama Siswa" prefWidth="230"/>
                        <TableColumn fx:id="colClass" text="Kelas" prefWidth="110"/>
                        <TableColumn fx:id="colSubject" text="Mata Pelajaran" prefWidth="190"/>
                    </columns>
                </TableView>

                <TextArea fx:id="areaWarnings" editable="false" wrapText="true" prefRowCount="3" promptText="Catatan penempatan akan tampil di sini"/>
            </VBox>
        </HBox>
    </center>

</BorderPane>