<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            fx:controller="co.id.controller.pages.UserManagementController"
            styleClass="list-menu-background">
    <top>
        <VBox spacing="10" styleClass="list-menu-top-vbox">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="User Management" styleClass="list-menu-top-label"/>
                <TextField fx:id="searchField" promptText="Cari..." />
                <Button fx:id="filterBtn" text="Cari">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16" >
                            <image>
                                <Image url="@/icons/loupe.png"/>
                            </image>
                        </ImageView>                    
                    </graphic>
                </Button>
                <Button fx:id="refreshBtn" text="Refresh">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16" >
                            <image>
                                <Image url="@/icons/refresh.png"/>
                            </image>
                        </ImageView>                    
                    </graphic>
                </Button>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="addBtn" text="Tambah" styleClass="list-menu-top-button">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16" >
                            <image>
                                <Image url="@/icons/add.png"/>
                            </image>
                        </ImageView>                    
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="10" styleClass="list-menu-center-vbox">
            <TableView fx:id="tableView" prefHeight="400">
                <columns>
                    <TableColumn fx:id="tableColumnAction" text="Aksi" prefWidth="220"/>
                    <TableColumn fx:id="tableColumnUsername" text="Username" prefWidth="130"/>
                    <TableColumn fx:id="tableColumnName" text="Nama" prefWidth="200"/>
                    <TableColumn fx:id="tableColumnRole" text="Role" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    
    <bottom>
        <VBox spacing="10" alignment="CENTER" styleClass="list-menu-bottom-vbox">
            <Pagination fx:id="pagination" pageCount="10" maxPageIndicatorCount="5"/>
        </VBox>
    </bottom>
</BorderPane>