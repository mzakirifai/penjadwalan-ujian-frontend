<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            fx:controller="co.id.controller.pages.TeachingAssignmentController"
            styleClass="list-menu-background">

    <top>
        <VBox spacing="10" styleClass="list-menu-top-vbox">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Pengampu" styleClass="list-menu-top-label"/>
                <TextField fx:id="searchField" promptText="Cari guru, mapel, kelas..." />
                <Button fx:id="filterBtn" text="Cari">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image><Image url="@/icons/loupe.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="refreshBtn" text="Refresh">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image><Image url="@/icons/refresh.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="templateBtn" text="Template">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image><Image url="@/icons/save.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="importBtn" text="Import Excel" styleClass="list-menu-top-button">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image><Image url="@/icons/report.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="addBtn" text="Tambah" styleClass="list-menu-top-button">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image><Image url="@/icons/add.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="list-menu-center-vbox">
            <TreeTableView fx:id="tableView" prefHeight="420" showRoot="false">
                <columns>
                    <TreeTableColumn fx:id="tableColumnTeacher" text="Nama Guru" prefWidth="260"/>
                    <TreeTableColumn fx:id="tableColumnNip" text="NIP" prefWidth="170"/>
                    <TreeTableColumn fx:id="tableColumnSubject" text="Mata Pelajaran" prefWidth="230"/>
                    <TreeTableColumn fx:id="tableColumnClassroom" text="Kelas" prefWidth="140"/>
                    <TreeTableColumn fx:id="tableColumnAction" text="Aksi" prefWidth="170"/>
                </columns>
            </TreeTableView>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="10" alignment="CENTER" styleClass="list-menu-bottom-vbox">
            <Pagination fx:id="pagination" pageCount="10" maxPageIndicatorCount="5"/>
        </VBox>
    </bottom>
</BorderPane>